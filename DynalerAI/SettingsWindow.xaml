<Window x:Class="DynalerAI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Dynaler AI" Height="480" Width="480"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner">

    <Border CornerRadius="14" Background="#1A0A2E"
            BorderBrush="#6C3FC5" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#6C3FC5" BlurRadius="20" Opacity="0.4" ShadowDepth="0"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Settings" FontSize="18" FontWeight="Bold"
                           Foreground="#E8E0FF" VerticalAlignment="Center"/>
                <Button Content="X" HorizontalAlignment="Right"
                        Style="{StaticResource DangerButton}" Width="32" Height="32"
                        Click="Close_Click"/>
            </Grid>

            <!-- Settings -->
            <StackPanel Grid.Row="1">

                <Border Background="#2D1B4E" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BUILT-IN API KEY" FontSize="10" FontWeight="Bold"
                                   Foreground="#8B7BAE" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="BuiltinKeyBox"
                                     Background="#0D0520" Foreground="#E8E0FF"
                                     BorderBrush="#6C3FC5" BorderThickness="1"
                                     Padding="10,8" FontSize="13"/>
                        <TextBlock Text="Used for the Built-in AI (ChatGPT) mode"
                                   FontSize="11" Foreground="#8B7BAE" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#2D1B4E" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="MAX RETRIES" FontSize="10" FontWeight="Bold"
                                       Foreground="#8B7BAE" Margin="0,0,0,6"/>
                            <TextBox x:Name="MaxRetriesBox" Style="{StaticResource DarkTextBox}" Text="2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="ACTION DELAY (MS)" FontSize="10" FontWeight="Bold"
                                       Foreground="#8B7BAE" Margin="0,0,0,6"/>
                            <TextBox x:Name="ActionDelayBox" Style="{StaticResource DarkTextBox}" Text="150"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#2D1B4E" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to system tray"
                                  Style="{StaticResource PurpleCheckBox}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="EnableLoggingCheck" Content="Enable history logging (history.log)"
                                  Style="{StaticResource PurpleCheckBox}"/>
                    </StackPanel>
                </Border>

                <Border Background="#2D1B4E" CornerRadius="10" Padding="16">
                    <TextBlock FontSize="12" Foreground="#8B7BAE" TextWrapping="Wrap">
                        <Run FontWeight="Bold" Foreground="#E8E0FF">Stop Hotkey:</Run>
                        <Run> Ctrl + Shift + S (global, works anytime)</Run>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- Save Button -->
            <Button Grid.Row="2" Content="Save Settings" Style="{StaticResource PurpleButton}"
                    Height="44" Margin="0,16,0,0" Click="Save_Click" FontSize="14"/>
        </Grid>
    </Border>
</Window>