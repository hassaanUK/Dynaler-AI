<Window x:Class="DynalerAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynaler AI" Height="700" Width="900"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize"
        MinWidth="700" MinHeight="500">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Border CornerRadius="16" Background="{StaticResource DarkPurpleBrush}"
            BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#6C3FC5" BlurRadius="30" Opacity="0.4" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource MidPurpleBrush}"
                    CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Resources/logo.png" Width="32" Height="32" Margin="0,0,10,0"/>
                        <TextBlock Text="Dynaler AI" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="v2.0" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Settings" Style="{StaticResource PurpleButton}" Width="70" Height="36"
                                Click="Settings_Click" Margin="0,0,4,0"/>
                        <Button Content="_" Style="{StaticResource PurpleButton}" Width="36" Height="36"
                                Click="Minimize_Click" Margin="0,0,4,0"/>
                        <Button Content="X" Style="{StaticResource DangerButton}" Width="36" Height="36"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource MidPurpleBrush}"
                            CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AI MODE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="AiModeCombo" Style="{StaticResource DarkComboBox}"
                                          SelectionChanged="AiMode_Changed">
                                    <ComboBoxItem Content="Built-in AI (ChatGPT)" IsSelected="True"/>
                                    <ComboBoxItem Content="Custom OpenAI Key"/>
                                    <ComboBoxItem Content="Anthropic Claude"/>
                                    <ComboBoxItem Content="Google Gemini"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="MODEL" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ModelCombo" Style="{StaticResource DarkComboBox}">
                                    <ComboBoxItem Content="gpt-4o" IsSelected="True"/>
                                    <ComboBoxItem Content="gpt-4o-mini"/>
                                    <ComboBoxItem Content="gpt-4-turbo"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" x:Name="ApiKeyPanel" Background="{StaticResource MidPurpleBrush}"
                            CornerRadius="10" Padding="14" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="API KEY" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="ApiKeyBox" Background="#0D0520"
                                         Foreground="{StaticResource TextLightBrush}"
                                         BorderBrush="{StaticResource PrimaryPurpleBrush}"
                                         BorderThickness="1" Padding="10,8" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{StaticResource MidPurpleBrush}"
                            CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="WHAT SHOULD THE AI DO?" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="GoalInput" Style="{StaticResource DarkTextBox}"
                                     Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="Open Notepad and type Hello World"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Background="{StaticResource MidPurpleBrush}"
                            CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <WrapPanel>
                            <CheckBox x:Name="SafeModeCheck" Content="Safe Mode"
                                      Style="{StaticResource PurpleCheckBox}" Margin="0,0,20,0"/>
                            <CheckBox x:Name="ScreenVisionCheck" Content="Screen Vision"
                                      Style="{StaticResource PurpleCheckBox}" Margin="0,0,20,0" IsChecked="True"/>
                            <CheckBox x:Name="AutoRetryCheck" Content="Auto Retry"
                                      Style="{StaticResource PurpleCheckBox}" IsChecked="True"/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="4" Background="{StaticResource MidPurpleBrush}"
                            CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ACTIVITY LOG" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" Foreground="{StaticResource TextLightBrush}"
                                           FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                           Text="[Dynaler AI v2.0 ready]"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="StartBtn" Content="Start AI"
                                Style="{StaticResource PurpleButton}" Height="44"
                                Click="Start_Click" FontSize="14"/>
                        <Button Grid.Column="2" x:Name="StopBtn" Content="Stop"
                                Style="{StaticResource DangerButton}" Height="44"
                                Click="Stop_Click" FontSize="14" IsEnabled="False"/>
                    </Grid>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource MidPurpleBrush}"
                            CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                         Fill="{StaticResource TextDimBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText" Text="Idle"
                                           Foreground="{StaticResource TextLightBrush}" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource MidPurpleBrush}"
                            CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ACTION PLAN" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PlanText" Text="No plan yet - start the AI to see steps"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{StaticResource MidPurpleBrush}"
                            CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="TASK PRESETS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1" x:Name="PresetsList"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextLightBrush}"
                                     FontSize="12" MouseDoubleClick="Preset_DoubleClick"/>
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Save Preset"
                                        Style="{StaticResource PurpleButton}" Height="32" FontSize="11"
                                        Click="SavePreset_Click"/>
                                <Button Grid.Column="2" Content="Del"
                                        Style="{StaticResource DangerButton}" Height="32" Width="36"
                                        Click="DeletePreset_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>